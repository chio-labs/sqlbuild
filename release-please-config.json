{
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "sqlbuild",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/sqlbuild-kata-native/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value == \"sqlbuild\")].version"
        }
      ]
    }
  }
}
