# Copy to sqlbuild_local.toml (gitignored) and fill in your own values.
# Never commit real account names, users, roles, warehouses or schemas.
target = "dev"

[connections.warehouse]
account = "<account-identifier>"
user = "<user>"
authenticator = "<authenticator>"
role = "<role>"
warehouse = "<warehouse>"

[targets.dev]
connection = "warehouse"
database = "<database>"
schema = "<schema>"

# The edge-case area's target (RUNBOOK.md, step 7). Use a different schema from targets.dev.
[connections.edge]
account = "<account-identifier>"
user = "<user>"
authenticator = "<authenticator>"
role = "<role>"
warehouse = "<warehouse>"

[targets.edge]
connection = "edge"
database = "<database>"
schema = "<edge-schema>"
